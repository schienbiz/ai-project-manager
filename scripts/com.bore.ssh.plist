<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Paths are placeholders because this repository is public.
     Install with:  sed "s|__HOME__|$HOME|g" <this file> > ~/Library/LaunchAgents/<label>.plist
     __HOME__ is the home directory of the account the agent runs as. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bore.ssh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/CloudSync/ai-project-manager/scripts/bore-ssh-tunnel.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/bore-ssh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/bore-ssh.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
