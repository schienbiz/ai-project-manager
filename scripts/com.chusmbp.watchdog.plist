<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Paths are placeholders because this repository is public.
     Install with:  sed "s|__HOME__|$HOME|g" <this file> > ~/Library/LaunchAgents/<label>.plist
     __HOME__ is the home directory of the account the agent runs as. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chusmbp.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/watchdog.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/tmp/watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/watchdog.err</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
